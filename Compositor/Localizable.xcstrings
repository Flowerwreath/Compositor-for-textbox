    },
    "Targeted Adjustment" : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "대상 조정"
          }
        }
      }
    },
    "Targeted adjustment: drag on the image to change that color's saturation, or its hue with Command held" : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "대상 조정: 이미지를 드래그하여 해당 색상의 채도를 바꾸십시오. 색조를 바꾸려면 Command를 누른 채 드래그하십시오."
          }
