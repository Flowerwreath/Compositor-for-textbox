    "·" : {
      "shouldTranslate" : false
    },
    "“%@” is a folder, which has no pixels of its own. Paint on a layer inside it, or on the folder’s mask." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@”은(는) 폴더라서 자체 픽셀이 없습니다. 안에 있는 레이어나 폴더의 마스크에 칠하십시오."
          }
        }
      }
    },
    "“%@” is an adjustment layer, with no pixels to paint. Paint on its mask instead." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@”은(는) 조정 레이어라서 칠할 픽셀이 없습니다. 대신 마스크에 칠하십시오."
          }
        }
      }
    },
    "“%@” is hidden, or inside a hidden folder. Show it to paint on it." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@”이(가) 숨겨져 있거나 숨겨진 폴더 안에 있습니다. 칠하려면 표시하십시오."
          }
        }
      }
    },
    "“%@” was changed on disk." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@”이(가) 디스크에서 변경되었습니다."
