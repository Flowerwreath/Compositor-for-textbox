          "stringUnit" : {
            "state" : "translated",
            "value" : "마스크 보기 중지"
          }
        }
      }
    },
    "Straightens barrel or pincushion bending." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "술통형 또는 핀쿠션형 휘어짐을 바로잡습니다."
