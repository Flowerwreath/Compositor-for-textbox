    "Strength" : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "강도"
          }
        }
      }
    },
    "Strengthens or weakens every color by the same amount." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "모든 색상을 같은 양만큼 강하게 하거나 약하게 합니다."
          }
        }
      }
    },
    "Strengthens or weakens the blue primary." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
