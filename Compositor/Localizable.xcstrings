    "Position" : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "위치"
          }
        }
      }
    },
    "Positive straightens lines that bow outward (barrel); negative, lines that bow inward (pincushion)." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "양수는 바깥으로 휜 선(술통형)을, 음수는 안으로 휜 선(핀쿠션형)을 바로잡습니다."
          }
        }
      }
    },
    "Positive values tighten the detected mask inward; negative values expand it outward" : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "양수 값은 감지된 마스크를 안쪽으로 좁히고, 음수 값은 바깥쪽으로 넓힙니다"
          }
        }
      }
    },
    "Preserve Luminosity" : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "광도 유지"
          }
        }
      }
    },
    "Preserves colored edges while color noise is reduced." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "색상 노이즈를 줄이는 동안 색이 있는 가장자리를 보존합니다."
          }
        }
      }
    },
    "Preserves fine texture while luminance noise is reduced." : {
      "localizations" : {
        "ko" : {
